snippet ... "\dots" iA
\dots
endsnippet

snippet dm "Math" wA
\[
	${1:${VISUAL}}
\] $0
endsnippet

snippet f/ "Fraction" iA
\frac{$1}{$2}$0
endsnippet

priority 10
snippet '(\d+)/' "number frac" wrA
\frac{`!p snip.rv = match.group(1)`}{$1}$0
endsnippet

snippet '([A-Za-z])(\d)' "auto subscript" wrA
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet

snippet === "equals" iA
\;&=\; $1 
endsnippet

snippet ^^ "to the ... power" iA
^{$1}$2
endsnippet

snippet __ "subscript" iA
_{$1}$2
endsnippet

snippet ooo "\infty" iA
\infty
endsnippet

snippet mcal "mathcal" iA
\mathcal{$1}$0
endsnippet

snippet lll "l" iA
\ell 
endsnippet

snippet DT "Delta" iA
\Delta{$1} $0 
endsnippet

snippet Dd "del (derivatives)" iA
\mathrm{d}{$1} $0 
endsnippet

snippet veps "epsilon" iA
\varepsilon 
endsnippet

snippet xx "cross" iA
\times 
endsnippet

snippet ** "cdot" iA
\cdot 
endsnippet

snippet '(?<!\\)formule' "formule" rwA
\formule{$1}{$2}$0
endsnippet

snippet !> "mapsto" iA
\mapsto 
endsnippet

snippet invs "inverse" iA
^{-1}
endsnippet

snippet -> "->" iA
\to
endsnippet

snippet >> ">>" iA
\gg
endsnippet

snippet << "<<" iA
\ll
endsnippet

snippet ~~ "~" iA
\sim 
endsnippet

snippet || "vert" iA
 \Vert
endsnippet

snippet oline "overline" iA
\overline{$1} $0
endsnippet

snippet Nn "cap" iA
\cap 
endsnippet

snippet Uu "cup" iA
\cup 
endsnippet

snippet OO "emptyset" iA
\emptyset
endsnippet

# vim:ft=snippets
