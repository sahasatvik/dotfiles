set guioptions                  none
set sandbox                     none
set selection-clipboard         clipboard
set page-cache-size             8

set statusbar-home-tilde        true
set window-title-basename       true

set font                        "Fira Mono 11"
set default-bg                  "#080808"
set default-fg                  "#ffffff"
set inputbar-bg                 "#1d1e20"
set inputbar-fg                 "#c5c7c6"
set statusbar-bg                "#1d1e20"
set statusbar-fg                "#c5c7c6"
set completion-highlight-bg     "#c5c7c6"
set completion-highlight-fg     "#1d1e20"
set recolor-lightcolor          "#080808"

