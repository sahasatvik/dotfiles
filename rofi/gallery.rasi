@theme "jellybeans"

* {
        selected-normal-background:
                                var(background);
        active-background:      var(background);
        selected-active-background:
                                var(background);
}

mainbox {
        children:               [ inputbar, listview ];
        padding:                12px;
}

inputbar {
        padding:                0 0 12px 0;
}

listview {
        lines:                  2;
        columns:                3;
        flow:                   horizontal;
        fixed-columns:          true;
        cycle:                  false;
        spacing:                4px;
        padding:                0;
}

element {
        border:                 2px;
        padding:                8px;
        orientation:            vertical;
}

element selected {
        border-color:           var(selected-normal-foreground);
}

element-icon {
        size:                   250px;
}

element-text {
        font:                   "Fira Code Nerd Font 10";
        padding:                6px 0 8px 0;
        margin:                 -6px 0 0 0;
        horizontal-align:       0.5;
        vertical-align:         0.5;
        background-color:       var(background);
}
