configuration {
        font:                   "Fira Code 11";
}

@theme "jellybeans"

window {
        location:               north east;
        anchor:                 north east;
        x-offset:               -6px;
        y-offset:               4px;
        width:                  calc(20ch + 24px);
        padding:                12px;
}

mainbox {
        children:               [ message ];
}

message {
        padding:                0;
        background-color:       var(background);
}

